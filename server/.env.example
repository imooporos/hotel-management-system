# Скопируйте в .env и подставьте реальные значения.
# .env читается автоматически приложением (pydantic-settings).

# Подключение к PostgreSQL
DATABASE_URL=postgresql://hotel_app:AppHotelStrong_pass_2026@localhost:5432/hotel_db

# JWT
JWT_SECRET=please_change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# CORS (через запятую). Для разработки можно "*".
CORS_ORIGINS=*

# Уровень логирования
LOG_LEVEL=INFO
